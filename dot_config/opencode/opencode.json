{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "edit": "ask",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "lsp": "allow",
        "bash": {
            "git diff": "allow",
            "git status": "allow"
        },
        "task": "ask",
        "webfetch": "allow",
        "websearch": "ask",
        "external_directory": "ask"
    },
    "enabled_providers": ["amazon-bedrock", "github-copilot", "opencode", "opencode-go"],
    "lsp": {
        "go": {
            "disabled": false,
            "command": ["gopls"],
            "extensions": [".go"]
        }
  }
}
