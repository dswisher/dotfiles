{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "edit": "ask",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "lsp": "allow",
        "bash": {
            "git diff": "allow",
            "git status": "allow"
        },
        "task": "ask",
        "webfetch": "allow",
        "websearch": "ask",
        "external_directory": "ask"
    },
    "enabled_providers": ["amazon-bedrock", "github-copilot", "opencode", "opencode-go"],
    "lsp": {
        "go": {
            "disabled": false,
            "command": ["gopls"],
            "extensions": [".go"]
        }
    },
    "mcp": {
        "staging-diff-manager": {
            "type": "remote",
            "url": "https://vir-diff-manager.feedgen.stg.rnc-feeds.dowjones.io/mcp",
            "enabled": false
        },
        "staging-file-librarian": {
            "type": "remote",
            "url": "https://vir-file-librarian.feedgen.stg.rnc-feeds.dowjones.io/mcp",
            "enabled": false
        },
        "staging-lookup-tracker": {
            "type": "remote",
            "url": "https://vir-lookup-tracker.feedgen.stg.rnc-feeds.dowjones.io/mcp",
            "enabled": false
        },
        "prod-diff-manager": {
            "type": "remote",
            "url": "https://vir-diff-manager.feedgen.rnc-feeds.dowjones.io/mcp",
            "enabled": false
        },
        "prod-file-librarian": {
            "type": "remote",
            "url": "https://vir-file-librarian.feedgen.rnc-feeds.dowjones.io/mcp",
            "enabled": false
        },
        "prod-lookup-tracker": {
            "type": "remote",
            "url": "https://vir-lookup-tracker.feedgen.rnc-feeds.dowjones.io/mcp",
            "enabled": false
        },
        "dmi": {
            "type": "local",
            "command": ["uv", "run", "--directory", "/Users/swisherd/git/rnc/snowflake/rnc-feeds-dmi-mcp", "mcp-server-dmi"],
            "enabled": false
        },
        "int-snowflake": {
            "type": "local",
            "command": ["uv", "run", "--directory", "/Users/swisherd/git/rnc/snowflake/dpc-snowflake-mcp", "mcp-server-snowflake"],
            "environment": {
                "SNOWFLAKE_USER": "DS_SA_DPC_MCP",
                "SNOWFLAKE_ACCOUNT": "DJ-DATASERVICES_INT_US_EAST_1",
                "SNOWFLAKE_DATABASE": "DS_LOCAL_SILVER",
                "SNOWFLAKE_WAREHOUSE": "DS_DPC_MCP_SMALL_WH",
                "SNOWFLAKE_ROLE": "DS_APP_DPC_MCP",
                "SNOWFLAKE_PRIVATE_KEY_FILE": "/Users/swisherd/.ssh/snowflake-mcp-key-int.p8"
            },
            "enabled": false
        },
        "prod-snowflake": {
            "type": "local",
            "command": ["uv", "run", "--directory", "/Users/swisherd/git/rnc/snowflake/dpc-snowflake-mcp", "mcp-server-snowflake", "--env-file", "/dev/null"],
            "environment": {
                "SNOWFLAKE_USER": "DOUG.SWISHER@DOWJONES.COM",
                "SNOWFLAKE_ACCOUNT": "DJ-DATASERVICES_PROD_US_EAST_1",
                "SNOWFLAKE_DATABASE": "DS_DPC_SILVER",
                "SNOWFLAKE_WAREHOUSE": "DS_XSMALL_WH",
                "SNOWFLAKE_ROLE": "DS_ANALYST",
                "SNOWFLAKE_PRIVATE_KEY_FILE": "/Users/swisherd/.ssh/snowflake-key-prod.p8"
            },
            "enabled": false
        }
    }
}
