{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "edit": "ask",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "lsp": "allow",
        "bash": {
            "git diff": "allow",
            "git status": "allow"
        },
        "task": "ask",
        "webfetch": "allow",
        "websearch": "ask",
        "external_directory": "ask"
    },
    "enabled_providers": ["amazon-bedrock", "github-copilot", "opencode", "opencode-go"],
    "lsp": {
        "go": {
            "disabled": false,
            "command": ["gopls"],
            "extensions": [".go"]
        }
    },
    "mcp": {
        "feedgen-diff": {
            "type": "remote",
            "url": "https://vir-diff-manager.feedgen.stg.rnc-feeds.dowjones.io/mcp",
            "enabled": false
        },
        "feedgen-file-librarian": {
            "type": "remote",
            "url": "https://vir-file-librarian.feedgen.stg.rnc-feeds.dowjones.io/mcp",
            "enabled": false
        },
        "feedgen-lookup-tracker": {
            "type": "remote",
            "url": "https://vir-lookup-tracker.feedgen.stg.rnc-feeds.dowjones.io/mcp",
            "enabled": false
        },
        "dmi": {
            "type": "local",
            "command": ["uv", "run", "--directory", "/Users/swisherd/git/rnc/snowflake/rnc-feeds-dmi-mcp", "mcp-server-dmi"],
            "enabled": false
        },
        "snowflake": {
            "type": "local",
            "command": ["uv", "run", "--directory", "/Users/swisherd/git/rnc/snowflake/dpc-snowflake-mcp", "mcp-server-snowflake"],
            "environment": {
                "SNOWFLAKE_USER": "DS_SA_DPC_MCP",
                "SNOWFLAKE_ACCOUNT": "DJ-DATASERVICES_INT_US_EAST_1",
                "SNOWFLAKE_DATABASE": "DS_LOCAL_SILVER",
                "SNOWFLAKE_WAREHOUSE": "DS_DPC_MCP_SMALL_WH",
                "SNOWFLAKE_ROLE": "DS_APP_DPC_MCP",
                "SNOWFLAKE_PRIVATE_KEY_FILE": "/Users/swisherd/.ssh/snowflake-mcp-key.p8"
            },
            "enabled": false
        }
    }
}
