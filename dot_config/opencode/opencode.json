{
    "$schema": "https://opencode.ai/config.json",
    "permissions": [
        { "action": "edit", "resource": "*", "effect": "ask" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "git diff", "effect": "allow" },
        { "action": "shell", "resource": "git status", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "ask" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "ask" },
        { "action": "external_directory", "resource": "*", "effect": "ask" },
        { "action": "atlassian_*", "resource": "*", "effect": "deny" },
        { "action": "atlassian_getAccessibleAtlassianResources", "resource": "*", "effect": "allow" },
        { "action": "atlassian_getJiraIssue", "resource": "*", "effect": "allow" },
        { "action": "atlassian_searchJiraIssuesUsingJql", "resource": "*", "effect": "allow" }
    ],
    "experimental": {
        "policies": [
            { "action": "provider.use", "resource": "*", "effect": "deny" },
            { "action": "provider.use", "resource": "amazon-bedrock", "effect": "allow" },
            { "action": "provider.use", "resource": "github-copilot", "effect": "allow" },
            { "action": "provider.use", "resource": "opencode", "effect": "allow" },
            { "action": "provider.use", "resource": "opencode-go", "effect": "allow" }
        ]
    },
    "lsp": {
        "go": {
            "disabled": false,
            "command": ["gopls"],
            "extensions": [".go"]
        }
    },
    "mcp": {
        "servers": {
            "atlassian": {
                "type": "remote",
                "url": "https://mcp.atlassian.com/v1/mcp",
                "oauth": {},
                "disabled": true
            },
            "nonprod-diff-manager": {
                "type": "remote",
                "url": "https://vir-diff-manager.feedgen.dev.rnc-feeds.dowjones.io/mcp",
                "disabled": true
            },
            "nonprod-file-librarian": {
                "type": "remote",
                "url": "https://vir-file-librarian.feedgen.dev.rnc-feeds.dowjones.io/mcp",
                "disabled": true
            },
            "nonprod-lookup-tracker": {
                "type": "remote",
                "url": "https://vir-lookup-tracker.feedgen.dev.rnc-feeds.dowjones.io/mcp",
                "disabled": true
            },
            "staging-diff-manager": {
                "type": "remote",
                "url": "https://vir-diff-manager.feedgen.stg.rnc-feeds.dowjones.io/mcp",
                "disabled": true
            },
            "staging-file-librarian": {
                "type": "remote",
                "url": "https://vir-file-librarian.feedgen.stg.rnc-feeds.dowjones.io/mcp",
                "disabled": true
            },
            "staging-lookup-tracker": {
                "type": "remote",
                "url": "https://vir-lookup-tracker.feedgen.stg.rnc-feeds.dowjones.io/mcp",
                "disabled": true
            },
            "prod-diff-manager": {
                "type": "remote",
                "url": "https://vir-diff-manager.feedgen.rnc-feeds.dowjones.io/mcp",
                "disabled": true
            },
            "prod-file-librarian": {
                "type": "remote",
                "url": "https://vir-file-librarian.feedgen.rnc-feeds.dowjones.io/mcp",
                "disabled": true
            },
            "prod-lookup-tracker": {
                "type": "remote",
                "url": "https://vir-lookup-tracker.feedgen.rnc-feeds.dowjones.io/mcp",
                "disabled": true
            },
            "dmi": {
                "type": "local",
                "command": ["uv", "run", "--directory", "/Users/swisherd/git/rnc/snowflake/rnc-feeds-dmi-mcp", "mcp-server-dmi"],
                "disabled": true
            },
            "chrome-devtools": {
                "type": "local",
                "command": [
                    "chrome-devtools-mcp",
                    "--browser-url=http://127.0.0.1:9222"
                ],
                "disabled": true
            },
            "int-snowflake": {
                "type": "local",
                "command": ["uv", "run", "--directory", "/Users/swisherd/git/rnc/snowflake/dpc-snowflake-mcp", "mcp-server-snowflake"],
                "environment": {
                    "SNOWFLAKE_USER": "DS_SA_DPC_MCP",
                    "SNOWFLAKE_ACCOUNT": "DJ-DATASERVICES_INT_US_EAST_1",
                    "SNOWFLAKE_DATABASE": "DS_LOCAL_SILVER",
                    "SNOWFLAKE_WAREHOUSE": "DS_DPC_MCP_SMALL_WH",
                    "SNOWFLAKE_ROLE": "DS_APP_DPC_MCP",
                    "SNOWFLAKE_PRIVATE_KEY_FILE": "/Users/swisherd/.ssh/snowflake-mcp-key-int.p8"
                },
                "disabled": true
            },
            "prod-snowflake": {
                "type": "local",
                "command": ["uv", "run", "--directory", "/Users/swisherd/git/rnc/snowflake/dpc-snowflake-mcp", "mcp-server-snowflake", "--env-file", "/dev/null"],
                "environment": {
                    "SNOWFLAKE_USER": "DOUG.SWISHER@DOWJONES.COM",
                    "SNOWFLAKE_ACCOUNT": "DJ-DATASERVICES_PROD_US_EAST_1",
                    "SNOWFLAKE_DATABASE": "DS_DPC_SILVER",
                    "SNOWFLAKE_WAREHOUSE": "DS_XSMALL_WH",
                    "SNOWFLAKE_ROLE": "DS_ANALYST",
                    "SNOWFLAKE_PRIVATE_KEY_FILE": "/Users/swisherd/.ssh/snowflake-key-prod.p8"
                },
                "disabled": true
            }
        }
    }
}