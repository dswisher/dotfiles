
# Homebrew takes care of updates
auto-update = off

# Always open new windows/tabs in home directory
working-directory = home

window-inherit-working-directory = false
tab-inherit-working-directory    = false
split-inherit-working-directory  = false

# Colors?
# background = #000080
# foreground = #F0F000

# Shut down the app when app windows go away
quit-after-last-window-closed = true

